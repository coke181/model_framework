# Linux 部署环境变量模板
# 用法：
# 1. 复制为 scripts/linux/deploy.env
# 2. 按你的阿里云服务器实际信息改值
# 3. systemd 或启动脚本会 source 这份文件
# 4. 当前建议部署形态：
#    - hello_service:    127.0.0.1:8080（通过 Nginx 对外提供 HTTP）
#    - hello_chat_gateway: 127.0.0.1:8090（通过 Nginx /ws 对外提供 WebSocket）
#    - MySQL / Redis 与服务同机，先走 127.0.0.1

HELLO_SERVICE_NAME=ue-game-backend
HELLO_SERVICE_ENV=production
HELLO_SERVICE_HOST=127.0.0.1
HELLO_SERVICE_PORT=8080
HELLO_SERVICE_STORAGE_MODE=mysql_redis
HELLO_SERVICE_PERF_MODE=0
HELLO_SERVICE_INSECURE_FAST_PASSWORD_HASH=0
HELLO_SERVICE_PASSWORD_ARGON2_MEMORY_KIB=19456
HELLO_SERVICE_PASSWORD_ARGON2_TIME_COST=2
HELLO_SERVICE_PASSWORD_ARGON2_PARALLELISM=1

HELLO_SERVICE_MYSQL_HOST=127.0.0.1
HELLO_SERVICE_MYSQL_PORT=3306
HELLO_SERVICE_MYSQL_USER=game_backend
HELLO_SERVICE_MYSQL_PASSWORD=change_me
HELLO_SERVICE_MYSQL_DATABASE=game_backend
HELLO_SERVICE_MYSQL_AUTO_MIGRATE=1
HELLO_SERVICE_MYSQL_SCHEMA_FILE=db/mysql/001_game_backend.sql

HELLO_SERVICE_REDIS_HOST=127.0.0.1
HELLO_SERVICE_REDIS_PORT=6379
HELLO_SERVICE_REDIS_PASSWORD=
HELLO_SERVICE_REDIS_DB=0
HELLO_SERVICE_REDIS_POOL_SIZE=16
HELLO_SERVICE_SERIALIZE_MUTATING_REQUESTS=true
HELLO_SERVICE_MAX_PENDING_TASKS_PER_KEY=256

HELLO_CHAT_GATEWAY_HOST=127.0.0.1
HELLO_CHAT_GATEWAY_PORT=8090

HELLO_SERVICE_GM_TOKEN=change_me_gm_token
HELLO_SERVICE_REQUEST_LOG_SAMPLE_RATE=10
HELLO_SERVICE_AUTO_BOOTSTRAP_DEV_ADMIN=0
HELLO_SERVICE_DEV_ADMIN_LOGIN=admin_demo
HELLO_SERVICE_DEV_ADMIN_PASSWORD=AdminDemo_123456
HELLO_SERVICE_DEV_ADMIN_DISPLAY_NAME=开发管理员

# LiveKit 语音服务。API Secret 只允许保存在服务器 deploy.env 中。
HELLO_SERVICE_LIVEKIT_URL=wss://voice.example.com
HELLO_SERVICE_LIVEKIT_API_KEY=change_me_livekit_key
HELLO_SERVICE_LIVEKIT_API_SECRET=change_me_livekit_secret
HELLO_SERVICE_VOICE_TOKEN_TTL_SECONDS=900
HELLO_SERVICE_VOICE_ROOM_PREFIX=blaster

OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://127.0.0.1:4318/v1/metrics
